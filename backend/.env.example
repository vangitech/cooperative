PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mpcs
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@mpcs.com
ADMIN_PASSWORD=admin1234
# Super-admin (SOLE full-rights role): set both, run `npm run migrate`, then
# sign in at /login. Or create anytime with
# `npm run make-superadmin -- <email> <password-min-8-chars>`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Flutterwave (test mode keys from Dashboard → Settings → API Keys)
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
# Random string you set in Dashboard → Settings → Webhooks; must match exactly
FLW_WEBHOOK_HASH=
# Where Flutterwave redirects after payment (must be allow-listed if required)
FUND_CALLBACK_URL=http://localhost:5173/payment/callback
# Transactional email via Resend (optional in dev — reset link is logged to console instead)
RESEND_API_KEY=
MAIL_FROM=MPCS <no-reply@mpcs.com>
# Public base URL of the frontend, used to build password-reset links
APP_URL=http://localhost:5173